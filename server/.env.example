# Google service account credentials (see server/README.md for setup steps).
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key from the downloaded JSON key with newlines escaped as \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Random secret used to sign session tokens. Generate with e.g. `openssl rand -base64 32`.
SESSION_SECRET=
